@attribute [Stories("Capture/HtmlToImage")]

<Stories TComponent="CapturePlayground">

    <Story Name="PNG">
        <Description>
            The default capture. <code>ToPngBytesAsync</code> streams the image over JS interop rather
            than marshalling a base64 data URL, so the bytes arrive without a 33% encoding tax.
        </Description>
        <Template>
            <CapturePlayground TestId="png"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Hint="ToPngBytesAsync captures the element as PNG bytes, streamed over JS interop instead of base64. Press Capture - the panel reports the real dimensions read from the PNG's own IHDR header, not what the DOM measured." />
        </Template>
    </Story>

    <Story Name="Pixel ratio">
        <Description>
            <code>PixelRatio</code> multiplies the output resolution while the element's CSS size stays
            the same. The poster is 320 CSS pixels wide, so a ratio of 3 produces a 960-pixel-wide PNG.
            This is what makes a captured poster look sharp when it lands in a messaging app.
        </Description>
        <Template>
            <CapturePlayground TestId="pixel-ratio"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_pixelRatioOptions"
                               Hint="PixelRatio multiplies output resolution while the element keeps its CSS size - what makes a shared poster look sharp. Ratio 3 against this 320px-wide poster produces a 960px-wide PNG." />
        </Template>
    </Story>

    <Story Name="Excluding elements">
        <Description>
            Upstream's <code>filter</code> is a JavaScript predicate, which cannot cross JS interop as a
            delegate without a round-trip per DOM node. It is modelled instead as
            <code>ExcludeCssClasses</code> and <code>ExcludeSelector</code>, which the interop layer
            compiles into a single filter function. Excluding a node excludes its whole subtree.
        </Description>
        <Template>
            <CapturePlayground TestId="exclude"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_excludeOptions"
                               ShowExcludedBadge="true"
                               Hint="ExcludeCssClasses drops matching elements and their whole subtrees from the capture. The red badge is in the live DOM but carries capture-ignore, so the captured image has no badge and is measurably shorter." />
        </Template>
    </Story>

    <Story Name="Background colour">
        <Description>
            The captured element's own background is transparent where CSS leaves it so.
            <code>BackgroundColor</code> fills that, which matters for JPEG - a format with no alpha
            channel, where transparency otherwise renders black.
        </Description>
        <Template>
            <CapturePlayground TestId="background"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_backgroundOptions"
                               Hint="BackgroundColor paints a backdrop behind the captured element - any CSS colour, here #ffd166. Essential for JPEG, which has no alpha channel and renders transparency as black." />
        </Template>
    </Story>

    <Story Name="JPEG">
        <Description>
            <code>Quality</code> runs from 0 to 1 and only affects JPEG. Lower quality means
            dramatically fewer bytes, which is what you want when the image is about to be uploaded.
        </Description>
        <Template>
            <CapturePlayground TestId="jpeg"
                               Kind="CapturePlayground.CaptureKind.Jpeg"
                               Options="_jpegOptions"
                               Hint="ToJpegBytesAsync captures as JPEG; Quality (0-1, here 0.5) trades fidelity for size before an upload. The panel confirms JPEG magic bytes and the byte length - compare it with the PNG story's." />
        </Template>
    </Story>

    <Story Name="SVG">
        <Description>
            <code>ToSvgAsync</code> inlines the subtree into an SVG <code>foreignObject</code> and
            returns it as a data URL. It stays resolution-independent, but rendering depends on the
            viewer's own CSS support.
        </Description>
        <Template>
            <CapturePlayground TestId="svg"
                               Kind="CapturePlayground.CaptureKind.Svg"
                               Hint="ToSvgAsync inlines the element into an SVG foreignObject and returns it as a data URL - resolution-independent, so it scales without pixelation. The preview below is that SVG rendered back by the browser." />
        </Template>
    </Story>

    <Story Name="Pixel data">
        <Description>
            <code>ToPixelDataAsync</code> returns raw RGBA bytes, four per pixel in row-major order -
            useful for analysis rather than display. The byte length is therefore
            <code>width x height x 4</code>.
        </Description>
        <Template>
            <CapturePlayground TestId="pixel-data"
                               Kind="CapturePlayground.CaptureKind.PixelData"
                               Hint="ToPixelDataAsync returns raw RGBA bytes, four per pixel in row-major order - for analysis rather than display, so there is no preview. Byte length equals width times height times 4." />
        </Template>
    </Story>

    <Story Name="Canvas">
        <Description>
            <code>ToCanvasAsync</code> returns the live <code>HTMLCanvasElement</code> as an
            <code>IJSObjectReference</code>, for handing to other JavaScript - a WebGL texture, a
            custom encoder, a compositing step. You own the reference: dispose it, or the canvas and
            its backing bitmap outlive the capture.
        </Description>
        <Template>
            <CapturePlayground TestId="canvas"
                               Kind="CapturePlayground.CaptureKind.Canvas"
                               Hint="ToCanvasAsync returns the live HTMLCanvasElement as an IJSObjectReference, for handing to other JavaScript (a WebGL texture, a custom encoder). Press Capture - the demo hands that element to a page script which attaches it below, proving it is a real canvas and not an encoded copy. The panel reports its width and height; the interop reference is disposed after, the DOM keeps the element." />
        </Template>
    </Story>

    <Story Name="Broken images">
        <Description>
            Upstream's <code>onImageErrorHandler</code> is a JavaScript callback, so it cannot be an
            option value. It is surfaced as the <code>ImageLoadFailed</code> event instead, wired only
            while something is subscribed - an unsubscribed capture passes no
            <code>DotNetObjectReference</code> and pays no interop cost.
            <br /><br />
            <strong>This event and <code>ImagePlaceholder</code> are alternatives, not
            complements.</strong> Upstream resolves a failed URL to the placeholder <em>before</em>
            assigning it to the cloned image, so with a placeholder set the clone loads successfully
            and the error never fires. Choose reporting or papering over, not both.
        </Description>
        <Template>
            <CapturePlayground TestId="broken"
                               Kind="CapturePlayground.CaptureKind.Png"
                               ShowBrokenImage="true"
                               Options="_placeholderOptions"
                               Hint="The ImageLoadFailed event reports every image that fails to load during a capture (upstream's onImageErrorHandler, reshaped). The poster contains a deliberately unresolvable image - the panel counts what the event delivered, and the capture still completes." />
        </Template>
    </Story>

    <Story Name="Explicit size">
        <Description>
            <code>Width</code> and <code>Height</code> are applied to the node before rendering, while
            <code>CanvasWidth</code> and <code>CanvasHeight</code> size the output canvas. Setting
            both is how you render a element at one size and export it at another.
        </Description>
        <Template>
            <CapturePlayground TestId="size"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_sizeOptions"
                               Hint="Width/Height resize the element before rendering; CanvasWidth/CanvasHeight size the output canvas independently. Here: rendered at 260x160, exported onto a 520x320 canvas - one element size, another export size." />
        </Template>
    </Story>

    <Story Name="Style overrides">
        <Description>
            <code>Style</code> copies CSS properties onto the node just for the capture, so the
            exported image can differ from what is on screen. <code>IncludeStyleProperties</code>
            narrows which computed properties get copied at all, which is the main lever when
            capturing a large subtree feels slow.
        </Description>
        <Template>
            <CapturePlayground TestId="style"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_styleOptions"
                               Hint="Style copies CSS onto the element only for the capture - here a border radius and rotation that are NOT applied on screen. IncludeStyleProperties narrows which computed properties get copied at all, the main speed lever on large subtrees." />
        </Template>
    </Story>

    <Story Name="Fonts and caching">
        <Description>
            <code>SkipFonts</code> avoids downloading and embedding web fonts entirely - much faster
            when the capture uses none. <code>PreferredFontFormat</code> narrows the embed to one
            format. <code>CacheBust</code> and <code>IncludeQueryParams</code> control how resource
            URLs are keyed, which is what to reach for when a capture keeps picking up a stale image.
        </Description>
        <Template>
            <CapturePlayground TestId="fonts"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_fontOptions"
                               Hint="SkipFonts avoids downloading and embedding web fonts entirely; PreferredFontFormat narrows the embed to one format; CacheBust and IncludeQueryParams control how resource URLs are cached. Together: the fastest configuration for a capture with no custom typography." />
        </Template>
    </Story>

    <Story Name="Fetch request init">
        <Description>
            <code>FetchRequestInit</code> applies request options to every resource html-to-image
            fetches while inlining the subtree. Set it when images or fonts need credentials or a
            specific CORS mode - the usual reason an otherwise-correct capture comes back with blank
            images.
        </Description>
        <Template>
            <CapturePlayground TestId="fetch"
                               Kind="CapturePlayground.CaptureKind.Png"
                               Options="_fetchOptions"
                               Hint="FetchRequestInit applies request options (CORS mode, credentials, cache, referrer) to every resource fetched while inlining the subtree - the fix when images or fonts come back blank for permission reasons. Here: cors mode, credentials omitted, cache bypassed." />
        </Template>
    </Story>

</Stories>

@code {
    private readonly HtmlToImageOptions _pixelRatioOptions = new()
    {
        PixelRatio = 3,
    };

    private readonly HtmlToImageOptions _excludeOptions = new()
    {
        ExcludeCssClasses = ["capture-ignore"],
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _backgroundOptions = new()
    {
        BackgroundColor = "#ffd166",
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _jpegOptions = new()
    {
        Quality = 0.5,
        BackgroundColor = "#101418",
        PixelRatio = 1,
    };
    private readonly HtmlToImageOptions _placeholderOptions = new()
    {
        // Deliberately NO ImagePlaceholder. Upstream resolves a failed URL to the placeholder
        // BEFORE assigning it to the cloned image, so the clone loads successfully and onerror -
        // and therefore ImageLoadFailed - never fires. The two options are alternatives, not
        // complements: a placeholder papers over the failure instead of reporting it.
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _sizeOptions = new()
    {
        Width = 260,
        Height = 160,
        CanvasWidth = 520,
        CanvasHeight = 320,
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _styleOptions = new()
    {
        Style = new Dictionary<string, string>
        {
            ["borderRadius"] = "36px",
            ["transform"] = "rotate(-2deg)",
        },
        IncludeStyleProperties = ["color", "background", "font", "border-radius", "transform", "padding"],
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _fontOptions = new()
    {
        SkipFonts = true,
        PreferredFontFormat = "woff2",
        CacheBust = true,
        IncludeQueryParams = true,
        SkipAutoScale = true,
        Type = "image/png",
        PixelRatio = 1,
    };

    private readonly HtmlToImageOptions _fetchOptions = new()
    {
        FetchRequestInit = new FetchRequestInit
        {
            Mode = "cors",
            Credentials = "omit",
            Cache = "no-store",
            ReferrerPolicy = "no-referrer",
        },
        PixelRatio = 1,
    };

}
