@implements IDisposable
@inject IHtmlToImageService _htmlToImage
@inject IJSRuntime _jsRuntime

<div class="demo-stack">
    @if (!Hint.IsNullOrEmpty())
    {
        <p class="demo-hint">@Hint</p>
    }

    <div @ref="_poster" id="@($"{TestId}-poster")" class="poster" data-testid="@($"{TestId}-poster")">
        <p class="poster-title">Session summary</p>
        <p class="poster-headline">120 kg x 5</p>
        <div class="poster-row">
            <span>Bench press</span>
            <span>PR</span>
        </div>
        @if (ShowBrokenImage)
        {
            @* Deliberately unresolvable. html-to-image reports it through onImageErrorHandler, and
               ImagePlaceholder decides whether the output shows a gap or the placeholder art. *@
            <img src="does-not-exist-anywhere.png" alt="" width="40" height="40" />
        }
        @if (ShowFetchedImage)
        {
            @* A same-origin solid #2a9d8f square. html-to-image re-fetches it with FetchRequestInit
               while inlining, so its colour in the capture proves the request options let it load. *@
            <img src="img/fetched-square.svg" alt="" width="40" height="40" data-testid="@($"{TestId}-fetched-image")" />
        }
        @if (ShowHangingImage)
        {
            @* Served normally this 404s at once. The browser test holds its request open instead, so
               the capture never finishes on its own and CaptureTimeoutMs is what ends it. *@
            <img src="img/never-arrives.png" alt="" width="40" height="40" />
        }
        @if (ShowExcludedBadge)
        {
            @* Carries the class the story passes as ExcludeCssClasses. Excluding never shrinks the
               output - the canvas keeps the element's layout size and the background shows where
               the badge was - so the browser test proves removal by sampling those pixels. *@
            <span class="poster-badge capture-ignore" data-testid="@($"{TestId}-badge")">
                Excluded by class
            </span>
            @* Second badge carries no class - only the attribute ExcludeSelector matches, so each
               badge proves its own filter path. *@
            <span class="poster-badge" data-demo-exclude data-testid="@($"{TestId}-badge-selector")">
                Excluded by selector
            </span>
        }
    </div>

    @if (Kind == CaptureKind.Concurrent)
    {
        @* Narrower than the 320px poster, so each of the two simultaneous captures can be told apart
           by the width of the image it returned. *@
        <div @ref="_narrowPoster" class="poster poster-narrow" data-testid="@($"{TestId}-narrow-poster")">
            <p class="poster-title">Narrow poster</p>
            <p class="poster-headline">80 kg x 8</p>
        </div>
    }

    <div class="demo-actions">
        <button data-testid="@($"{TestId}-capture")" @onclick="Capture">Capture</button>
    </div>

    @if (!_previewDataUrl.IsNullOrEmpty())
    {
        <div class="capture-preview">
            <img src="@_previewDataUrl" alt="Captured result" data-testid="@($"{TestId}-preview")" />
        </div>
    }
    @if (Kind == CaptureKind.Canvas)
    {
        @* ToCanvasAsync's result is a LIVE element, so the demo proves it by handing it to a page
           script that attaches it here - not by re-encoding it into an <img>. *@
        <div class="capture-preview" @ref="_canvasHost" data-testid="@($"{TestId}-canvas-host")"></div>
    }

    <CaptureState TestId="@($"{TestId}-state")" Json="@_stateJson" />
</div>

@code {
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public CaptureKind Kind { get; set; } = CaptureKind.Png;

    [Parameter]
    public HtmlToImageOptions? Options { get; set; }

    [Parameter]
    public bool ShowExcludedBadge { get; set; }

    /// <summary>Adds an image whose URL cannot resolve, so the ImageLoadFailed event has something to report.</summary>
    [Parameter]
    public bool ShowBrokenImage { get; set; }

    /// <summary>Adds a same-origin image that the capture has to fetch, so request options have something to apply to.</summary>
    [Parameter]
    public bool ShowFetchedImage { get; set; }

    /// <summary>Adds an image whose request the browser test holds open, so only the capture timeout can end the capture.</summary>
    [Parameter]
    public bool ShowHangingImage { get; set; }

    /// <summary>
    /// Calls <c>GetFontEmbedCssAsync</c> before the capture and reports the resulting CSS length in
    /// the panel. An empty string is the correct answer for this demo (it uses no web fonts) - the
    /// point is proving the call round-trips.
    /// </summary>
    [Parameter]
    public bool ShouldProbeFontCss { get; set; }

    private int? _fontCssLength;

    private ElementReference _poster;
    private ElementReference _narrowPoster;
    private ElementReference _canvasHost;
    private string _previewDataUrl = string.Empty;
    private string _stateJson = "{}";
    private readonly List<string> _failedImages = [];

    protected override void OnInitialized()
    {
        // Subscribing is what makes the wrapper wire onImageErrorHandler at all - without a
        // subscriber it passes no DotNetObjectReference and the capture pays no interop cost.
        _htmlToImage.ImageLoadFailed += OnImageLoadFailed;
    }

    private void OnImageLoadFailed(string url)
    {
        _failedImages.Add(url);
    }

    public void Dispose()
    {
        _htmlToImage.ImageLoadFailed -= OnImageLoadFailed;
    }

    private async Task Capture()
    {
        try
        {
            if (ShouldProbeFontCss)
            {
                var fontCss = await _htmlToImage.GetFontEmbedCssAsync(_poster, Options);
                _fontCssLength = fontCss.Length;
            }

            switch (Kind)
            {
                case CaptureKind.Png:
                    var pngBytes = await _htmlToImage.ToPngBytesAsync(_poster, Options);
                    _previewDataUrl = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
                    WriteState(pngBytes, "png");
                    break;

                case CaptureKind.PngDataUrl:
                    // Deliberately the data-URL method AND the element-id overload: the byte-stream
                    // path over ElementReference is covered by every other PNG story, so this one
                    // pins ToPngAsync, the id-based node resolution, and the base64 round-trip.
                    var pngDataUrl = await _htmlToImage.ToPngAsync($"{TestId}-poster", Options);
                    var decodedPngBytes = Convert.FromBase64String(pngDataUrl[(pngDataUrl.IndexOf(',') + 1)..]);
                    _previewDataUrl = pngDataUrl;
                    WriteState(decodedPngBytes, "png");
                    break;

                case CaptureKind.Jpeg:
                    var jpegBytes = await _htmlToImage.ToJpegBytesAsync(_poster, Options);
                    _previewDataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(jpegBytes)}";
                    WriteState(jpegBytes, "jpeg");
                    break;

                case CaptureKind.Svg:
                    var svgDataUrl = await _htmlToImage.ToSvgAsync(_poster, Options);
                    _previewDataUrl = svgDataUrl;
                    WriteSvgState(svgDataUrl);
                    break;

                case CaptureKind.Canvas:
                    // The interop reference is disposed as soon as the demo has used it - the DOM
                    // keeps the attached element; only the .NET handle is released.
                    await using (var canvas = await _htmlToImage.ToCanvasAsync(_poster, Options))
                    {
                        var width = await canvas.GetValueAsync<int>("width");
                        var height = await canvas.GetValueAsync<int>("height");
                        // Hand the LIVE element to page JS and attach it below - the whole point of
                        // ToCanvasAsync over ToPngAsync, demonstrated rather than described.
                        await _jsRuntime.InvokeVoidAsync("demoAttachCanvas", canvas, _canvasHost);
                        _previewDataUrl = string.Empty;
                        _stateJson = Serialize(new Dictionary<string, object?>
                        {
                            ["hasCaptured"] = true,
                            ["format"] = "canvas",
                            ["width"] = width,
                            ["height"] = height,
                            ["failedImages"] = _failedImages.Count,
                            ["error"] = null,
                        });
                    }
                    break;



                case CaptureKind.Concurrent:
                    // Imports the interop module first. On a cold service the module lock queues the
                    // second capture behind the first one's import, so the two would never actually
                    // overlap in the browser.
                    await _htmlToImage.GetFontEmbedCssAsync(_narrowPoster, Options);
                    // Both captures run on the one shared service at the same time; neither may pick up
                    // the other's element, options or result.
                    var posterCapture = _htmlToImage.ToPngBytesAsync(_poster, Options);
                    var narrowPosterCapture = _htmlToImage.ToPngBytesAsync(_narrowPoster, Options);
                    var capturedPngs = await Task.WhenAll(posterCapture, narrowPosterCapture);
                    var posterSize = ImageHeader.ReadPngSize(capturedPngs.First());
                    var narrowPosterSize = ImageHeader.ReadPngSize(capturedPngs.Last());
                    _previewDataUrl = string.Empty;
                    _stateJson = Serialize(new Dictionary<string, object?>
                    {
                        ["hasCaptured"] = true,
                        ["format"] = "concurrent",
                        ["posterWidth"] = posterSize?.Width,
                        ["narrowPosterWidth"] = narrowPosterSize?.Width,
                        ["error"] = null,
                    });
                    break;

                case CaptureKind.PixelData:
                    // A PNG of the same element with the same options is the reference: its IHDR
                    // size is the canvas the pixel data has to cover, independent of the CSS size.
                    var referencePng = ImageHeader.ReadPngSize(await _htmlToImage.ToPngBytesAsync(_poster, Options));
                    var pixelData = await _htmlToImage.ToPixelDataAsync(_poster, Options);
                    _previewDataUrl = string.Empty;
                    _stateJson = Serialize(new Dictionary<string, object?>
                    {
                        ["hasCaptured"] = true,
                        ["format"] = "pixelData",
                        ["byteLength"] = pixelData.Bytes.Length,
                        ["width"] = pixelData.Width,
                        ["height"] = pixelData.Height,
                        ["referenceWidth"] = referencePng?.Width,
                        ["referenceHeight"] = referencePng?.Height,
                        ["error"] = null,
                    });
                    break;
            }
        }
        catch (Exception exception)
        {
            _stateJson = Serialize(new Dictionary<string, object?>
            {
                ["hasCaptured"] = false,
                ["error"] = exception.Message,
            });
        }
    }

    private void WriteState(byte[] bytes, string format)
    {
        var size = ImageHeader.ReadPngSize(bytes);

        _stateJson = Serialize(new Dictionary<string, object?>
        {
            ["hasCaptured"] = true,
            ["format"] = format,
            ["byteLength"] = bytes.Length,
            ["isPng"] = ImageHeader.IsPng(bytes),
            ["isJpeg"] = ImageHeader.IsJpeg(bytes),
            ["width"] = size?.Width,
            ["height"] = size?.Height,
            ["failedImages"] = _failedImages.Count,
            ["fontCssLength"] = _fontCssLength,
            ["error"] = null,
        });
    }

    private void WriteSvgState(string dataUrl)
    {
        _stateJson = Serialize(new Dictionary<string, object?>
        {
            ["hasCaptured"] = true,
            ["format"] = "svg",
            ["byteLength"] = dataUrl.Length,
            ["isSvgDataUrl"] = dataUrl.StartsWith("data:image/svg+xml", StringComparison.Ordinal),
            ["error"] = null,
        });
    }

    private static string Serialize(Dictionary<string, object?> state)
    {
        return JsonSerializer.Serialize(state, new JsonSerializerOptions { WriteIndented = true });
    }

    public enum CaptureKind
    {
        Png,
        /// <summary>PNG via the data-URL method and the element-id overload, exercising both alternate call shapes.</summary>
        PngDataUrl,
        Jpeg,
        Svg,
        PixelData,
        /// <summary>Returns the live HTMLCanvasElement rather than an encoded image.</summary>
        Canvas,
        /// <summary>Two PNG captures of two different elements, started together on the same service.</summary>
        Concurrent
    }
}
