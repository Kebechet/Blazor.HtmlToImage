@implements IDisposable
@inject IHtmlToImageService _htmlToImage
@inject IJSRuntime _jsRuntime

<div class="demo-stack">
    @if (!Hint.IsNullOrEmpty())
    {
        <p class="demo-hint">@Hint</p>
    }

    <div @ref="_poster" class="poster" data-testid="@($"{TestId}-poster")">
        <p class="poster-title">Session summary</p>
        <p class="poster-headline">120 kg x 5</p>
        <div class="poster-row">
            <span>Bench press</span>
            <span>PR</span>
        </div>
        @if (ShowBrokenImage)
        {
            @* Deliberately unresolvable. html-to-image reports it through onImageErrorHandler, and
               ImagePlaceholder decides whether the output shows a gap or the placeholder art. *@
            <img src="does-not-exist-anywhere.png" alt="" width="40" height="40" />
        }
        @if (ShowExcludedBadge)
        {
            @* Carries the class the story passes as ExcludeCssClasses, so a correct capture drops
               it - and the badge is deliberately the tallest element, making its removal visible
               in the output height rather than only in the pixels. *@
            <span class="poster-badge capture-ignore" data-testid="@($"{TestId}-badge")">
                Excluded from capture
            </span>
        }
    </div>

    <div class="demo-actions">
        <button data-testid="@($"{TestId}-capture")" @onclick="Capture">Capture</button>
    </div>

    @if (!_previewDataUrl.IsNullOrEmpty())
    {
        <div class="capture-preview">
            <img src="@_previewDataUrl" alt="Captured result" data-testid="@($"{TestId}-preview")" />
        </div>
    }
    @if (Kind == CaptureKind.Canvas)
    {
        @* ToCanvasAsync's result is a LIVE element, so the demo proves it by handing it to a page
           script that attaches it here - not by re-encoding it into an <img>. *@
        <div class="capture-preview" @ref="_canvasHost" data-testid="@($"{TestId}-canvas-host")"></div>
    }

    <CaptureState TestId="@($"{TestId}-state")" Json="@_stateJson" />
</div>

@code {
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public CaptureKind Kind { get; set; } = CaptureKind.Png;

    [Parameter]
    public HtmlToImageOptions? Options { get; set; }

    [Parameter]
    public bool ShowExcludedBadge { get; set; }

    /// <summary>Adds an image whose URL cannot resolve, so the ImageLoadFailed event has something to report.</summary>
    [Parameter]
    public bool ShowBrokenImage { get; set; }

    private ElementReference _poster;
    private ElementReference _canvasHost;
    private string _previewDataUrl = string.Empty;
    private string _stateJson = "{}";
    private readonly List<string> _failedImages = [];

    protected override void OnInitialized()
    {
        // Subscribing is what makes the wrapper wire onImageErrorHandler at all - without a
        // subscriber it passes no DotNetObjectReference and the capture pays no interop cost.
        _htmlToImage.ImageLoadFailed += OnImageLoadFailed;
    }

    private void OnImageLoadFailed(string url)
    {
        _failedImages.Add(url);
    }

    public void Dispose()
    {
        _htmlToImage.ImageLoadFailed -= OnImageLoadFailed;
    }

    private async Task Capture()
    {
        try
        {
            switch (Kind)
            {
                case CaptureKind.Png:
                    var pngBytes = await _htmlToImage.ToPngBytesAsync(_poster, Options);
                    _previewDataUrl = $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
                    WriteState(pngBytes, "png");
                    break;

                case CaptureKind.Jpeg:
                    var jpegBytes = await _htmlToImage.ToJpegBytesAsync(_poster, Options);
                    _previewDataUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(jpegBytes)}";
                    WriteState(jpegBytes, "jpeg");
                    break;

                case CaptureKind.Svg:
                    var svgDataUrl = await _htmlToImage.ToSvgAsync(_poster, Options);
                    _previewDataUrl = svgDataUrl;
                    WriteSvgState(svgDataUrl);
                    break;

                case CaptureKind.Canvas:
                    // The interop reference is disposed as soon as the demo has used it - the DOM
                    // keeps the attached element; only the .NET handle is released.
                    await using (var canvas = await _htmlToImage.ToCanvasAsync(_poster, Options))
                    {
                        var width = await canvas.GetValueAsync<int>("width");
                        var height = await canvas.GetValueAsync<int>("height");
                        // Hand the LIVE element to page JS and attach it below - the whole point of
                        // ToCanvasAsync over ToPngAsync, demonstrated rather than described.
                        await _jsRuntime.InvokeVoidAsync("demoAttachCanvas", canvas, _canvasHost);
                        _previewDataUrl = string.Empty;
                        _stateJson = Serialize(new Dictionary<string, object?>
                        {
                            ["hasCaptured"] = true,
                            ["format"] = "canvas",
                            ["width"] = width,
                            ["height"] = height,
                            ["failedImages"] = _failedImages.Count,
                            ["error"] = null,
                        });
                    }
                    break;



                case CaptureKind.PixelData:
                    var pixels = await _htmlToImage.ToPixelDataAsync(_poster, Options);
                    _previewDataUrl = string.Empty;
                    WriteState(pixels, "pixelData");
                    break;
            }
        }
        catch (Exception exception)
        {
            _stateJson = Serialize(new Dictionary<string, object?>
            {
                ["hasCaptured"] = false,
                ["error"] = exception.Message,
            });
        }
    }

    private void WriteState(byte[] bytes, string format)
    {
        var size = ImageHeader.ReadPngSize(bytes);

        _stateJson = Serialize(new Dictionary<string, object?>
        {
            ["hasCaptured"] = true,
            ["format"] = format,
            ["byteLength"] = bytes.Length,
            ["isPng"] = ImageHeader.IsPng(bytes),
            ["isJpeg"] = ImageHeader.IsJpeg(bytes),
            ["width"] = size?.Width,
            ["height"] = size?.Height,
            ["failedImages"] = _failedImages.Count,
            ["error"] = null,
        });
    }

    private void WriteSvgState(string dataUrl)
    {
        _stateJson = Serialize(new Dictionary<string, object?>
        {
            ["hasCaptured"] = true,
            ["format"] = "svg",
            ["byteLength"] = dataUrl.Length,
            ["isSvgDataUrl"] = dataUrl.StartsWith("data:image/svg+xml", StringComparison.Ordinal),
            ["error"] = null,
        });
    }

    private static string Serialize(Dictionary<string, object?> state)
    {
        return JsonSerializer.Serialize(state, new JsonSerializerOptions { WriteIndented = true });
    }

    public enum CaptureKind
    {
        Png,
        Jpeg,
        Svg,
        PixelData,

        /// <summary>Returns the live HTMLCanvasElement rather than an encoded image.</summary>

        Canvas
    }
}
